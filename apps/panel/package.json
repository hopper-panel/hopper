{
  "name": "@hopper/panel",
  "version": "0.7.3",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "Hopper panel — NestJS API and web interface",
  "main": "./dist/main.js",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "cli": "tsx src/cli/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/static": "^10.1.2",
    "@hopper/shared": "workspace:*",
    "@hopper/templates": "workspace:*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-fastify": "^11.1.6",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.19.3",
    "@simplewebauthn/server": "^13.3.2",
    "fastify": "^5.11.2",
    "ioredis": "^6.0.0",
    "jose": "^6.2.8",
    "mysql2": "^3.23.2",
    "nodemailer": "^9.0.4",
    "otpauth": "^9.5.1",
    "prisma": "^6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "yaml": "^2.9.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@hopper/config": "workspace:*",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.8",
    "@nestjs/testing": "^11.1.6",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^8.0.1",
    "eslint": "^9.35.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.23.5",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  }
}
