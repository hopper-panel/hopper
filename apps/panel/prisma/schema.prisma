// Data schema of the Hopper panel.
//
// Conventions:
//  • Every entity exposed in the public API carries a `uuid` on top of its
//    auto-incremented `id`. The `id` is for foreign keys, the `uuid` for URLs:
//    it tells nobody how many users or servers exist.
//  • Secrets (passwords, tokens, API keys) are never stored in clear text. The
//    field then carries the `Hash` suffix.
//  • Cascading deletes are explicit: deleting a node must never silently erase
//    servers. See the `onDelete: Restrict`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users and authentication
// ---------------------------------------------------------------------------

enum UserRole {
  /// Full access, nodes and every server included.
  ADMIN
  /// Only reaches the servers it owns or is a subuser of.
  USER
}

model User {
  id       Int      @id @default(autoincrement())
  uuid     String   @unique @default(uuid())
  email    String   @unique
  username String   @unique
  role     UserRole @default(USER)

  passwordHash String

  /// TOTP secret, encrypted by CryptoService. Null while 2FA is inactive.
  totpSecret    String?
  /// False until the user has validated a first code: a secret that has been
  /// generated but not confirmed must not lock the account out.
  totpConfirmed Boolean @default(false)

  /// Single-use recovery codes, hashed. Cleared when 2FA is disabled.
  recoveryCodes RecoveryCode[]

  /// A suspended account can no longer sign in, but its servers keep running:
  /// cutting the players off a community server over a billing dispute would be
  /// disproportionate.
  suspended Boolean @default(false)

  lastLoginAt DateTime?
  lastLoginIp String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions        Session[]
  apiKeys         ApiKey[]
  applicationKeys ApplicationKey[]    @relation("ApplicationKeyCreator")
  passkeys        Passkey[]
  challenges      WebauthnChallenge[]
  ownedServers    Server[]            @relation("ServerOwner")
  subuserOf       Subuser[]
  auditEntries    AuditLog[]          @relation("AuditActor")

  @@index([suspended])
  @@map("users")
}

model RecoveryCode {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Hash of the code. The clear-text code is shown once, at generation time.
  codeHash String
  usedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("recovery_codes")
}

/// Refresh session. The access token itself is not stored: it is verified by
/// signature and lives a few minutes.
model Session {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Hash of the current refresh token. Rotated at every refresh.
  tokenHash String @unique

  /// Rotation chain: detecting the reuse of an old token revokes the whole
  /// family. This is the countermeasure against refresh-token theft.
  family String

  userAgent String?
  ip        String?

  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([family])
  @@index([expiresAt])
  @@map("sessions")
}

/// A WebAuthn credential — a passkey.
///
/// Nothing here is a secret. The private key never leaves the authenticator,
/// so a dump of this table lets nobody sign in: it holds only public keys and
/// the identifiers needed to recognise them.
model Passkey {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Credential ID, base64url. Unique across the instance and not only per
  /// user: the same authenticator must not be registrable twice, and a login
  /// with a discoverable credential arrives with no username to scope the
  /// lookup by.
  credentialId String @unique
  /// COSE public key, base64. Verifies the signatures; reveals nothing.
  publicKey    String

  /// Signature counter. An authenticator that goes backwards has been cloned —
  /// some never count at all and stay at zero, which is not the same thing.
  counter BigInt @default(0)

  /// How the browser reached it: usb, nfc, ble, internal, hybrid. Passed back
  /// at login so the browser can suggest the right one instead of asking.
  transports String[]

  /// A credential synchronised across a vendor's devices survives losing the
  /// phone; one bound to a single device does not. Worth showing, because it
  /// decides whether a second passkey is a nice idea or the only way back in.
  backedUp Boolean @default(false)

  /// What the user called it. They own several and have to tell them apart.
  name String

  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("passkeys")
}

/// One in-flight WebAuthn ceremony.
///
/// The challenge has to be remembered between the two round trips, and it
/// cannot live in the client's hands: whoever chooses the challenge chooses
/// what the signature covers. In the database rather than in Redis because
/// Redis is optional here, and an optional dependency must not decide whether
/// signing in works.
model WebauthnChallenge {
  id Int @id @default(autoincrement())

  /// Random, base64url. Looked up by value, so it is the key.
  challenge String @unique

  /// Null for a login: a discoverable credential says who it is afterwards.
  /// Set for a registration, which always happens inside a session.
  userId Int?
  user   User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Registration or authentication. A challenge minted for one must not be
  /// spent on the other.
  purpose String

  /// Short. A ceremony is a user tapping a key, not a session.
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("webauthn_challenges")
}

model ApiKey {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Public part of the key, in clear text: used to find the row.
  identifier String @unique
  /// Secret part, hashed.
  tokenHash  String

  memo   String
  /// Permissions granted to the key, a subset of the user's own.
  scopes String[]

  /// Restriction by source IP. Empty = no restriction.
  allowedIps String[]

  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("api_keys")
}

/// Machine identity, for the software a hosting provider runs beside the panel.
///
/// Deliberately not an `ApiKey` with a flag. An `ApiKey` borrows its owner's
/// access, which is right for a key somebody pastes into a script and wrong for
/// the credential a billing system provisions with: that one has to keep
/// working when the administrator who created it is demoted, leaves, or has
/// their account deleted — none of which should stop a customer's server from
/// being delivered. So it belongs to nobody, and `createdById` is a note for
/// the trail rather than a dependency.
///
/// It opens `/api/application/*` and nothing else. Not the administration, not
/// a console, not a file. A credential that lives in a billing server's
/// configuration file is the one most likely to leak, and the blast radius of
/// this one is bounded by the surface it can reach rather than by the promise
/// that nobody will misuse it.
model ApplicationKey {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid())

  /// What the key is for, in an operator's words: "Paymenter", "WHMCS".
  name String

  /// Public part, in clear text: finds the row without comparing the secret
  /// against the whole table.
  identifier String @unique
  /// Secret part, hashed.
  tokenHash  String

  /// `read`, `write`, or both. Coarse on purpose, like the personal keys.
  scopes String[]

  /// Restriction by source address. Empty = no restriction. A billing server
  /// has a fixed address far more often than a human does, so this one is
  /// worth filling in.
  allowedIps String[]

  /// Revoked rather than deleted: a key that provisioned servers stays
  /// nameable in the audit trail afterwards.
  revokedAt DateTime?

  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  /// Who created it. `SetNull`, and that is the point: the key outlives the
  /// account.
  createdById Int?
  createdBy   User? @relation("ApplicationKeyCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])
  @@map("application_keys")
}

// ---------------------------------------------------------------------------
// Infrastructure: nodes and ports
// ---------------------------------------------------------------------------

model Node {
  id          Int    @id @default(autoincrement())
  uuid        String @unique @default(uuid())
  name        String
  description String @default("")

  /// Domain name of the daemon. Has to resolve from the panel AND from the
  /// users' browsers: the console connects to it directly.
  fqdn   String
  scheme String @default("https")
  port   Int    @default(8443)

  /// Public part of the token, in clear text: identifies the node in a header.
  daemonTokenId        String @unique
  /// Secret part, encrypted with AES-256-GCM by CryptoService.
  ///
  /// Encrypted and not hashed, unlike passwords: the same token serves both
  /// directions. The panel *presents* it to the daemon to drive the containers,
  /// and *verifies* it when the daemon calls back on `/api/remote/*`. A one-way
  /// hash would rule the first use out.
  ///
  /// The decryption key comes from APP_SECRET, which lives in the environment
  /// file and not in the database: a SQL dump alone is therefore not enough to
  /// take control of the nodes.
  daemonTokenEncrypted String
  /// Shared secret signing the console JWTs. Encrypted with AES-256-GCM by
  /// CryptoService before it is written: a dump of the database must not be
  /// enough to forge console tokens.
  jwtSecret            String

  /// Declared capacity, in bytes. Used for the overallocation check.
  /// BigInt and not Int: a PostgreSQL `integer` tops out at 2.1 GB, which is
  /// enough neither for a node's RAM nor for the size of a disk.
  memoryBytes          BigInt @default(0)
  diskBytes            BigInt @default(0)
  /// Percentage of overcommit allowed. -1 = no limit, 0 = strict.
  memoryOverallocation Int    @default(0)
  diskOverallocation   Int    @default(0)

  /// A node in maintenance refuses the creation of new servers; the existing
  /// servers keep running.
  maintenance Boolean @default(false)

  sftpPort Int @default(2022)

  /// IANA timezone the servers on this node run in, e.g. `Europe/Paris`.
  ///
  /// It reaches every container as `TZ`, which is what decides the time
  /// written in front of each line of a game server's log. The daemon has
  /// always read it from `system.timezone` in daemon.yml and defaulted to UTC
  /// — but nothing ever wrote it, so every installation ran on UTC and every
  /// operator outside it read their own logs an hour or six off.
  ///
  /// Stored here rather than in the file because the file is generated: it is
  /// rewritten from this row every time a token is rotated or the
  /// configuration is applied, and anything edited into it by hand is lost at
  /// the next rotation.
  timezone String @default("UTC")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allocations   Allocation[]
  databaseHosts DatabaseHost[]
  /// Plans that may be placed here. Empty on both sides means "no restriction",
  /// which is what an instance with one node wants and never has to say.
  plans         Plan[]         @relation("PlanNodes")
  /// Restrict and not Cascade: deleting a node that still hosts servers has to
  /// fail, not destroy their data.
  servers       Server[]

  @@map("nodes")
}

model Allocation {
  id     Int  @id @default(autoincrement())
  nodeId Int
  node   Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  ip    String
  port  Int
  /// Name shown to players in place of the IP, e.g. `mc.example.com`.
  alias String?

  /// What this port is for, as the server's own configuration reaches it:
  /// `rcon`, `query`, `voice`. Free text is `alias`; this is a lookup key, and
  /// the shape is enforced by `allocationRoleSchema` on the way in.
  ///
  /// Nullable, and null on every port that existed before names did. Null is
  /// also what an unnamed port keeps for ever: naming is opt-in, and a port
  /// with no name is reached the way it always was.
  role String?

  serverId Int?
  server   Server? @relation("ServerAllocations", fields: [serverId], references: [id], onDelete: SetNull)

  /// Counterpart of `Server.primaryAllocation`. Prisma requires both sides of a
  /// relation; it is the uniqueness of `Server.primaryAllocationId` that
  /// guarantees a port is the primary port of a single server.
  primaryForServer Server? @relation("PrimaryAllocation")

  /// A port can only be allocated once per node.
  @@unique([nodeId, ip, port])
  /// A name means one port **per server**, and the constraint says exactly
  /// that without a partial index or a trigger — because PostgreSQL treats
  /// NULLs in a unique index as distinct from each other. Two unnamed ports on
  /// the same server are `(7, NULL)` twice and do not collide; two ports named
  /// `rcon` on the same server are `(7, 'rcon')` twice and do. A named port
  /// sitting in the node's free pool is `(NULL, 'rcon')` and collides with
  /// nothing either, which is right: it belongs to no server, so it is nobody's
  /// `rcon` — and the service clears the name when a port is handed back, so
  /// the case should not arise in the first place.
  ///
  /// The service checks for a duplicate before writing all the same. Not
  /// because the constraint is unreliable, but because what it produces is a
  /// P2002 the operator reads as "Internal server error"; the check exists to
  /// name the port already holding the name.
  @@unique([serverId, role])
  @@index([serverId])
  @@map("allocations")
}

/// A sellable offer: what a customer gets for what they pay.
///
/// It exists because of who calls the API. Without it, a billing system has to
/// know the panel's internals to sell anything — which template UUID, how many
/// bytes of memory, which node has a free port, and a dozen more fields — and
/// every one of those lives in a second place, in a second product's
/// configuration, drifting from this one. A plan moves that knowledge here,
/// where it can be changed by the person who decides what is sold, and leaves
/// the billing system a name.
///
/// It is a **template for creating a server**, not a live dependency. Limits
/// are copied onto the server at creation, exactly as the startup command is
/// copied from its template: editing an offer must not silently change what
/// two hundred existing customers are running. Moving a server onto a plan's
/// current limits is a deliberate act, and it has a route of its own.
model Plan {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid())

  /// Stable identifier chosen by the operator: `minecraft-4gb`.
  ///
  /// The billing system references this and not the uuid, because it is what a
  /// human types into a product's configuration and reads back in a support
  /// ticket. Renaming a plan is therefore a breaking change for whatever sells
  /// it, which is the honest trade for never having to look up an identifier.
  slug        String @unique
  name        String
  description String @default("")

  templateId Int
  template   Template @relation(fields: [templateId], references: [id], onDelete: Restrict)

  /// Which of the template's images to run. Empty = the template's default.
  /// A provider selling "Java 8" and "Java 21" from one template needs this;
  /// one selling a single image never sets it.
  dockerImage String @default("")

  // What the customer gets. Same units and same meaning as the columns of the
  // same name on `Server`, because that is where they are copied.
  memoryBytes     BigInt
  swapBytes       BigInt  @default(0)
  diskBytes       BigInt
  cpuPercent      Int     @default(0)
  ioWeight        Int     @default(500)
  pidsLimit       Int     @default(512)
  oomKillDisabled Boolean @default(false)

  backupLimit     Int @default(3)
  databaseLimit   Int @default(0)
  allocationLimit Int @default(0)

  /// Where servers on this plan may be placed. Empty = anywhere.
  ///
  /// A many-to-many rather than one node per plan: an offer usually exists on
  /// every machine of a region, and duplicating the offer per node would make
  /// the billing system choose the machine — which is the decision this whole
  /// model exists to take away from it.
  nodes Node[] @relation("PlanNodes")

  /// A retired offer stops being sellable; the customers on it keep running.
  ///
  /// Deleting is also possible and does the same to the servers, thanks to the
  /// `SetNull` above — but it loses the name, and "which plan was this sold
  /// under" is a question support asks about servers whose offer was withdrawn
  /// two years ago.
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  servers Server[]

  @@index([active])
  @@map("plans")
}

// ---------------------------------------------------------------------------
// Server templates (the counterpart of the "eggs")
// ---------------------------------------------------------------------------

model TemplateGroup {
  id          Int    @id @default(autoincrement())
  uuid        String @unique @default(uuid())
  name        String @unique
  description String @default("")

  /// Who to ask about the templates in this group.
  ///
  /// Free text and empty by default, because it is answering a question the
  /// interchange format cannot: a Pterodactyl egg carries an `author` of its
  /// own but says nothing whatsoever about its parent — across the 274 eggs of
  /// the public corpus the string `"nest"` does not appear once. So a group's
  /// author is never imported and never exported; it is a note the operator
  /// writes for the next operator, which is the only thing it can honestly be.
  author String @default("")

  templates Template[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("template_groups")
}

model Template {
  id      Int           @id @default(autoincrement())
  uuid    String        @unique @default(uuid())
  groupId Int
  group   TemplateGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)

  /// Stable identifier, independent of the displayed name.
  ///
  /// This is the update key of the catalogue shipped with Hopper: renaming
  /// "Paper" to "PaperMC" must neither create a second template nor orphan the
  /// servers attached to it.
  key String @unique

  name        String
  description String @default("")
  author      String @default("")

  /// True as soon as an administrator has edited this template from the panel.
  ///
  /// Updates of the bundled catalogue then skip this template: without that
  /// guard, a Hopper update would silently overwrite a customised Docker image
  /// or an adjusted startup command, and the servers concerned would stop
  /// working with no explanation.
  modifiedByAdmin Boolean @default(false)

  /// Docker images on offer, shaped as `[{ "name": "Java 21", "image": "…" }]`.
  ///
  /// An array and not an object: `jsonb` reorders the keys of an object (by
  /// length, then alphabetically), so that "the first image" had no stable
  /// meaning. A server created without an explicit choice ended up with an
  /// arbitrary image — Java 8 for a template whose intended default was Java
  /// 21. The first entry of the array is the default.
  dockerImages Json
  /// Template of the startup command, `{{VAR}}` variables included.
  startup      String

  /// How to stop the server: `command:stop` or `signal:SIGTERM`.
  stopCommand String @default("command:stop")

  /// How to stop the server when the string above cannot say it
  /// (StopConfiguration shape from the contract).
  ///
  /// Nullable, and every existing row keeps a NULL: the panel then decodes
  /// `stopCommand` exactly as it always has. Two words separated by a colon
  /// cannot carry an RCON stop — a command, a password variable and a port
  /// name — so the structured form lives here instead of being encoded into a
  /// column every existing template and every imported egg already fills.
  stop Json?

  /// Seconds a server gets to shut down before it is SIGKILLed.
  ///
  /// Nullable, meaning "this template did not say", which the panel turns into
  /// the contract's default of 30. That default is a Minecraft figure and it
  /// is wrong for a game that writes its whole world on shutdown, where the
  /// kill lands inside the save — but changing it for everybody would extend
  /// every stop on every existing server, so it is the template's to raise.
  stopTimeoutSeconds Int?

  /// Regex signalling that the server is ready.
  startupDetection String?

  /// How the server announces it is ready (Readiness shape from the contract).
  ///
  /// Nullable, and every existing row keeps a NULL: the daemon then falls back
  /// to `startupDetection` above, which is what the whole catalogue and every
  /// imported egg still declare. A default of any kind would have been a
  /// choice made on behalf of templates whose author never expressed one — and
  /// the only honest default, `immediate`, is precisely the silent "it is up,
  /// call it running" this column exists to make explicit.
  readiness Json?

  /// Files rewritten before every start (ConfigFile shape from the contract).
  configFiles  Json     @default("[]")
  /// Glob patterns the user can neither read nor modify.
  fileDenylist String[]

  installContainer  String @default("debian:bookworm-slim")
  installEntrypoint String @default("/bin/bash")
  installScript     String @default("")

  /// Milliseconds the installation may do nothing at all before the daemon
  /// stops it — no output, no CPU, no disk I/O.
  ///
  /// Nullable, meaning "this template did not say", and the daemon then applies
  /// its own generous default. Not a total-duration cap: a Steam depot that
  /// takes an hour of solid downloading is alive, and any duration large enough
  /// to accommodate it would never fire on a stalled one. Not a cap on output
  /// either — `curl -sSL` prints nothing at all while it transfers, which is how
  /// nearly every install script downloads.
  ///
  /// The container's network counters are deliberately not among the three, and
  /// this column used to say they were. They count frames an interface accepted
  /// — including the ARP a Linux bridge floods to every port on it — rather than
  /// work this container did, so watching them made a stalled install look busy
  /// on exactly the crowded nodes where one that never ends costs the most.
  installInactivityTimeoutMs Int?

  /// Bytes this installation is expected to write, when the template knows.
  ///
  /// `BigInt` and not `Int`: a Steam depot passes the four-billion mark that a
  /// 32-bit column stops at, and the failure would be an insert rejected at the
  /// far end of a template import rather than anything legible.
  ///
  /// Nullable, and the vast majority of templates keep a NULL: a Minecraft
  /// server's size is whatever modpack its variables point at. The daemon then
  /// asks only for its own floor of free space, and refuses nothing else.
  ///
  /// That floor is **not** the behaviour installations had before this column
  /// existed. There was no disk check of any kind: an installation started
  /// whatever the node had left, and a modpack larger than the free space filled
  /// the machine and took every server on it down. So a NULL here is the weaker
  /// of the two guards rather than the absence of one, and a node with under a
  /// gigabyte free now refuses an installation it would once have accepted —
  /// which is the point.
  installRequiredDiskBytes BigInt?

  /// UUID of the original Pterodactyl egg, to avoid double imports.
  importedFromEgg String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variables TemplateVariable[]
  servers   Server[]
  /// `Restrict` on the other side: deleting a template that a sellable offer
  /// points at has to fail rather than leave the offer unable to create
  /// anything.
  plans     Plan[]

  @@unique([groupId, name])
  @@index([groupId])
  @@map("templates")
}

model TemplateVariable {
  id         Int      @id @default(autoincrement())
  templateId Int
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  name         String
  description  String @default("")
  /// Name of the environment variable, e.g. `MINECRAFT_VERSION`.
  envVariable  String
  defaultValue String @default("")

  /// The user sees the variable in the interface.
  userViewable Boolean @default(true)
  /// The user can edit it. An editable variable is an input to the startup
  /// command: the rules below are the only barrier against a hostile value.
  userEditable Boolean @default(false)

  /// Validation rules, e.g. `required|string|max:20`.
  rules String @default("nullable|string")

  /// Where this variable sits on the Startup page, low first.
  ///
  /// Without it the order is whatever Postgres hands back, which is stable
  /// enough to look deliberate and changes the day a row is updated. That is
  /// tolerable for a catalogue nobody edits and not for a form an author fills
  /// in: an egg puts the version above the jar file above the flags because
  /// that is the order somebody fills them in, and a list that reshuffles
  /// itself on save reads as a bug in the editor.
  ///
  /// Not unique, and deliberately: an editor that renumbers a whole list has to
  /// be able to write `0,1,2,3` over `0,1,2,3` without colliding with itself
  /// halfway through. Ties fall back to `id`, so a template whose variables all
  /// sit at 0 — every row that predates this column — keeps the order it has
  /// today rather than acquiring a new arbitrary one.
  sort Int @default(0)

  @@unique([templateId, envVariable])
  @@index([templateId, sort])
  @@map("template_variables")
}

// ---------------------------------------------------------------------------
// Servers
// ---------------------------------------------------------------------------

enum ServerStatus {
  /// Created in the database, the daemon has not confirmed the install yet.
  INSTALLING
  INSTALL_FAILED
  /// Operational.
  READY
  /// Suspended by an administrator: no start, no files, no SFTP.
  SUSPENDED
  /// Deletion under way on the daemon side.
  DELETING
  /// Reinstall requested.
  REINSTALLING
}

model Server {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid())

  name        String
  description String @default("")

  ownerId Int
  owner   User @relation("ServerOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  nodeId Int
  node   Node @relation(fields: [nodeId], references: [id], onDelete: Restrict)

  templateId Int
  template   Template @relation(fields: [templateId], references: [id], onDelete: Restrict)

  /// The offer this server was sold under, when it was sold under one.
  ///
  /// Null for every server an administrator creates by hand, and for every
  /// server that existed before plans did — which is why it is nullable rather
  /// than defaulted to some "custom" row nobody asked for.
  ///
  /// `SetNull` on delete: retiring an offer must not refuse to delete it
  /// because customers are still on it, and must not delete their servers
  /// either. What they run is copied onto the server at creation; the plan is a
  /// record of what was sold, not a live dependency.
  planId Int?
  plan   Plan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  status ServerStatus @default(INSTALLING)

  /// Primary allocation: the one injected into `server-port`.
  primaryAllocationId Int?         @unique
  primaryAllocation   Allocation?  @relation("PrimaryAllocation", fields: [primaryAllocationId], references: [id], onDelete: SetNull)
  /// Extra allocations (dynmap, voice chat, query…).
  allocations         Allocation[] @relation("ServerAllocations")

  // Resource limits. 0 = unlimited, except for pidsLimit.
  // See Node.memoryBytes for the choice of BigInt.
  memoryBytes     BigInt
  swapBytes       BigInt  @default(0)
  diskBytes       BigInt
  cpuPercent      Int     @default(0)
  cpuSet          String  @default("")
  ioWeight        Int     @default(500)
  pidsLimit       Int     @default(512)
  oomKillDisabled Boolean @default(false)

  dockerImage    String
  startupCommand String

  /// The daemon has to recreate the container on the next start.
  requiresRebuild Boolean @default(false)

  /// Number of concurrent backups allowed. 0 = backups disabled.
  backupLimit     Int @default(3)
  /// Number of databases allowed (phase 7).
  databaseLimit   Int @default(0)
  /// Extra allocations the user can assign on their own.
  allocationLimit Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variables    ServerVariable[]
  subusers     Subuser[]
  backups      Backup[]
  databases    Database[]
  schedules    Schedule[]
  webhooks     Webhook[]
  auditEntries AuditLog[]       @relation("AuditServer")

  @@index([ownerId])
  @@index([nodeId])
  @@index([templateId])
  @@index([planId])
  @@index([status])
  @@map("servers")
}

/// Outgoing notification, triggered by an event on a server.
///
/// Attached to a server and not to the instance: it is the server's owner who
/// wants to hear about its restarts, and they alone should be able to aim an
/// outgoing request from the panel.
model Webhook {
  id       Int    @id @default(autoincrement())
  uuid     String @unique @default(uuid())
  serverId Int
  server   Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  url         String
  description String @default("")

  /// Subscribed events. Empty = nothing is sent.
  events String[]

  /// HMAC signing key, encrypted at rest. The recipient uses it to check that
  /// the request really comes from this panel.
  secretEncrypted String

  active Boolean @default(true)

  /// Last attempt: HTTP status, or network error message.
  lastStatus    Int?
  lastError     String?
  lastAttemptAt DateTime?
  lastSuccessAt DateTime?
  /// Consecutive failures. Past the threshold, the webhook disables itself.
  failureCount  Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serverId])
  @@map("webhooks")
}

model ServerVariable {
  id       Int    @id @default(autoincrement())
  serverId Int
  server   Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  /// Copy of the environment variable name: a template edited after the fact
  /// must not break the startup command of an existing server.
  envVariable String
  value       String

  @@unique([serverId, envVariable])
  @@map("server_variables")
}

model Subuser {
  id       Int    @id @default(autoincrement())
  uuid     String @unique @default(uuid())
  serverId Int
  server   Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  userId   Int
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Permissions granted, values of `PERMISSIONS` in @hopper/shared.
  permissions String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([serverId, userId])
  @@index([userId])
  @@map("subusers")
}

// ---------------------------------------------------------------------------
// Backups and scheduling
// ---------------------------------------------------------------------------

/// Where a backup's archive lives.
///
/// Only LOCAL exists. S3 is declared and nothing implements it — not the
/// daemon, not the panel — and it is not selectable anywhere, so no row has
/// ever carried it. It stays in the enum rather than being dropped because
/// removing a value is a migration that would fail on any instance that did
/// somehow hold one, and it buys nothing: what made this a problem was
/// `docs/security.md` recommending it as a feature, which it no longer does.
enum BackupDriver {
  LOCAL
  /// Not implemented. Reserved.
  S3
}

model Backup {
  id       Int    @id @default(autoincrement())
  uuid     String @unique @default(uuid())
  serverId Int
  server   Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  name   String
  driver BackupDriver @default(LOCAL)

  /// Patterns excluded from the archive, inherited from the template then
  /// customisable.
  ignoredFiles String[]

  sizeBytes BigInt  @default(0)
  /// SHA-256 of the archive, verified before any restore.
  checksum  String?

  /// Null until the daemon has returned its verdict.
  successful  Boolean?
  errorDetail String?

  /// A locked backup can be deleted neither by retention nor by the user: it is
  /// the safety net before a risky operation.
  locked Boolean @default(false)

  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([serverId])
  @@index([createdAt])
  @@map("backups")
}

model Schedule {
  id       Int    @id @default(autoincrement())
  uuid     String @unique @default(uuid())
  serverId Int
  server   Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  name String

  cronMinute     String @default("*")
  cronHour       String @default("*")
  cronDayOfMonth String @default("*")
  cronMonth      String @default("*")
  cronDayOfWeek  String @default("*")

  active         Boolean @default(true)
  /// Do nothing if the server is stopped, instead of starting it.
  onlyWhenOnline Boolean @default(false)

  lastRunAt DateTime?
  nextRunAt DateTime?
  /// True while running: prevents two concurrent triggers.
  running   Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks ScheduleTask[]

  @@index([serverId])
  @@index([active, nextRunAt])
  @@map("schedules")
}

enum TaskAction {
  COMMAND
  POWER
  BACKUP
}

model ScheduleTask {
  id         Int      @id @default(autoincrement())
  uuid       String   @unique @default(uuid())
  scheduleId Int
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  /// Order of execution within the scheduled task.
  sequence Int
  action   TaskAction
  /// Command to send, power action, or patterns to exclude from the backup.
  payload  String     @default("")

  /// Seconds to wait before this step: makes it possible to announce a restart
  /// then wait for the players to disconnect.
  offsetSeconds Int @default(0)

  /// Carry on with the sequence even if this step fails.
  continueOnFailure Boolean @default(false)

  @@unique([scheduleId, sequence])
  @@map("schedule_tasks")
}

// ---------------------------------------------------------------------------
// Audit log
// ---------------------------------------------------------------------------

model AuditLog {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid())

  /// Null for an action issued by the system (scheduler, daemon).
  actorId Int?
  actor   User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  /// Null for an action that does not concern a server (creating a node).
  ///
  /// Cascading: the history of a server disappears with it. The deletion itself
  /// is logged at the instance level, with a null `serverId` and the server's
  /// UUID in `metadata` — so it survives the cascade.
  serverId Int?
  server   Server? @relation("AuditServer", fields: [serverId], references: [id], onDelete: Cascade)

  /// Identifier of the action, e.g. `server.power.start`, `auth.login.failed`.
  event String

  ip        String?
  userAgent String?
  /// Structured context: file path, previous value, and so on.
  metadata  Json    @default("{}")

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([serverId])
  @@index([event])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Instance settings
// ---------------------------------------------------------------------------

/// Settings editable from the administration interface, as opposed to the
/// environment variables, which require a restart.
model Setting {
  key   String @id
  value String

  updatedAt DateTime @updatedAt

  @@map("settings")
}

/// MySQL or MariaDB server on which the panel can create databases.
///
/// The panel connects to it with an administration account: it is the panel
/// that creates the databases, the accounts and the grants. That account is
/// therefore the key to the whole SQL server — hence the encrypted storage,
/// rather than hashed: the panel has to present it at every connection.
model DatabaseHost {
  id   Int    @id @default(autoincrement())
  uuid String @unique @default(uuid())
  name String

  /// Address through which the **panel** reaches the SQL server.
  host String
  port Int    @default(3306)

  username          String
  /// Encrypted with APP_SECRET. See CryptoService.
  passwordEncrypted String

  /// Address announced to the **players** to connect to their database. Often
  /// different from `host`: the panel goes through an internal network, the
  /// clients through the public address.
  publicHost String?
  publicPort Int?

  /// Restricts this host to one node: a database should live near its server.
  /// Null, it is offered to all of them.
  nodeId Int?
  node   Node? @relation(fields: [nodeId], references: [id], onDelete: SetNull)

  databases Database[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("database_hosts")
}

/// Database assigned to a server.
model Database {
  id       Int    @id @default(autoincrement())
  uuid     String @unique @default(uuid())
  serverId Int
  server   Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  hostId Int
  host   DatabaseHost @relation(fields: [hostId], references: [id], onDelete: Restrict)

  /// Real name on the SQL server, prefixed with the server's identifier.
  database          String
  username          String
  /// Encrypted: the user has to be able to read it back to configure a plugin.
  passwordEncrypted String
  /// Host pattern allowed to connect, `%` by default.
  remote            String @default("%")

  createdAt DateTime @default(now())

  @@unique([hostId, database])
  @@index([serverId])
  @@map("databases")
}
