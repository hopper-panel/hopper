# Copiez ce fichier en .env et remplacez les valeurs.
#
#   APP_SECRET : générez-le, ne le réutilisez jamais entre deux instances.
#     openssl rand -base64 48
#
# Ce fichier ne doit contenir aucun secret réel : .env est ignoré par Git,
# .env.example ne l'est pas.

NODE_ENV=development

APP_URL=http://localhost:8080
HOST=127.0.0.1
PORT=8080

APP_SECRET=replace-me-with-at-least-32-random-characters

DATABASE_URL=postgresql://hopper:hopper@127.0.0.1:5432/hopper
REDIS_URL=redis://127.0.0.1:6379

# Daemon de développement (voir apps/daemon/daemon.dev.yml).
# En production, les nodes sont enregistrés dans le panel, pas ici.
DEV_NODE_URL=http://127.0.0.1:8443
DEV_NODE_TOKEN=devdevdevdevdev0.devsecretdevsecretdevsecretdevsecretdevsecretdevsecretdevsecret0
