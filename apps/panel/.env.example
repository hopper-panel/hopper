# Copy this file to .env and replace the values.
#
#   APP_SECRET: generate it, and never reuse it across two instances.
#     openssl rand -base64 48
#
# This file must hold no real secret: .env is ignored by Git, .env.example is
# not.

NODE_ENV=development

APP_URL=http://localhost:8080
HOST=127.0.0.1
PORT=8080

APP_SECRET=replace-me-with-at-least-32-random-characters

DATABASE_URL=postgresql://hopper:hopper@127.0.0.1:5432/hopper
REDIS_URL=redis://127.0.0.1:6379

# Development daemon (see apps/daemon/daemon.dev.yml).
# In production the nodes are registered in the panel, not here.
DEV_NODE_URL=http://127.0.0.1:8443
DEV_NODE_TOKEN=devdevdevdevdev0.devsecretdevsecretdevsecretdevsecretdevsecretdevsecretdevsecret0
