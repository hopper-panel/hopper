{
  "name": "@hopper/daemon",
  "version": "0.6.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "hopperd — the Hopper agent installed on each host machine",
  "bin": {
    "hopperd": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/index.ts --config daemon.dev.yml",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.0",
    "@hopper/shared": "workspace:*",
    "dockerode": "^5.0.1",
    "fastify": "^5.6.0",
    "jose": "^6.2.8",
    "pino": "^10.3.1",
    "ssh2": "^1.17.0",
    "tar-stream": "^3.2.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@hopper/config": "workspace:*",
    "@types/dockerode": "^4.0.1",
    "@types/node": "^22.15.0",
    "@types/ssh2": "^1.15.5",
    "@types/tar-stream": "^3.1.4",
    "@types/ws": "^8.18.1",
    "eslint": "^9.35.0",
    "pino-pretty": "^13.1.1",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  }
}
