# Dependencies
node_modules/
.pnpm-store/

# Builds
dist/
build/
out/
*.tsbuildinfo

# Prisma client
#
# Since Prisma 7 the client is generated as TypeScript into the source tree
# rather than into node_modules. It is a build artefact all the same: rebuilt by
# `prisma generate` on postinstall, and again by the installer before the panel
# is built. Committing it would mean a schema and a client that can disagree.
apps/panel/src/generated/

# Turborepo
.turbo/

# Environment — NEVER commit secrets
.env
.env.*
!.env.example

# Session credentials left behind by hand-testing the API.
#
# `curl -c` writes a cookie jar holding a live refresh token; one was committed
# in the initial import and reached the public remote. The pattern is unanchored
# so it catches the jar wherever the curl was run from.
cookies.txt
*.cookies

# Local dev data
#
# `.hopper-dev` is the daemon root in development: it holds the server volumes,
# that is Minecraft worlds and .jar files weighing tens of megabytes. Without an
# unanchored pattern, a `git add -A` run after a test stages a hundred and fifty
# of them at once.
.hopper-dev/
data/
volumes/
*.sqlite
*.sqlite-journal

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
logs/

# Tests
coverage/
.nyc_output/
playwright-report/
test-results/

# Editors / OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.recommended.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Certificates and keys generated locally
*.pem
*.key
!**/fixtures/**/*.pem
!**/fixtures/**/*.key
