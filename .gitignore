.vscode/*
!.vscode/extensions.json
!.vscode/settings.recommended.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Certificats et clés générés localement
*.pem
*.key
!**/fixtures/**/*.pem
!**/fixtures/**/*.key
