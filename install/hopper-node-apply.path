[Unit]
Description=Watch for a local daemon configuration request
Documentation=https://github.com/hopper-panel/hopper

[Path]
# The panel's entire power here: creating this file. What it holds is a node
# uuid and nothing else — no command, no path, no shell — and what happens next
# is decided by hopper-node-apply.service, which the panel can neither read nor
# alter.
PathExists=/var/lib/hopper/node-apply/requested
Unit=hopper-node-apply.service

[Install]
WantedBy=multi-user.target
