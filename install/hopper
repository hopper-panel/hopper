#!/bin/sh
#
# Launcher for the Hopper command line.
#
# The CLI lives inside the panel package: it needs its Prisma client, its .env
# and its working directory. This script saves having to remember that, and
# makes `hopper doctor` usable from anywhere.
set -eu

HOPPER_ROOT="${HOPPER_ROOT:-/opt/hopper}"
PANEL="$HOPPER_ROOT/apps/panel"

if [ ! -f "$PANEL/dist/cli/main.js" ]; then
  echo "Hopper cannot be found in $HOPPER_ROOT." >&2
  echo "Set HOPPER_ROOT, or build the panel: pnpm --filter @hopper/panel build" >&2
  exit 1
fi

cd "$PANEL"
exec node dist/cli/main.js "$@"
