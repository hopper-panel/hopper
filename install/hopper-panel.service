[Unit]
Description=Hopper Panel
Documentation=https://github.com/hopper-panel/hopper
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target

# In [Unit], not [Service]: systemd has read them here since v230 and
# ignores them there, with nothing but a line in the journal to say so.
# The rate limit they were supposed to impose did not exist — a CI run
# caught the daemon restarting four times in twenty seconds, unbounded.
StartLimitBurst=5
StartLimitIntervalSec=120

[Service]
Type=simple

# The panel, for its part, has no reason to be privileged: it touches neither
# Docker nor the server volumes. It only talks to its database and to the
# daemons, over the network.
User=hopper
Group=hopper

WorkingDirectory=/opt/hopper/apps/panel
ExecStart={{NODE}} dist/main.js
EnvironmentFile=/opt/hopper/apps/panel/.env

# The working directory is the panel package, not the installation root, so
# nothing in the process can derive where Hopper was installed. The update check
# reads `.hopper-commit` from here, and the administration shows the path of
# install.sh from it; without this both looked two levels too deep and the
# panel reported no known version at all.
Environment=HOPPER_ROOT=/opt/hopper

Restart=on-failure
RestartSec=5

# Hardening: the panel must not write anywhere on the filesystem.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false

# Two writable paths, and only two: where the panel drops its request for an
# update, and where it drops its request for this machine's daemon
# configuration. Each holds a trigger file and a status the root-side unit
# writes back — no code, no configuration, nothing the panel could execute.
# Everything else still goes through the database and journald.
#
# The second was missing, and the whole feature sat behind it: `ProtectSystem=
# strict` makes every other path read-only, so the panel writing into
# /var/lib/hopper/node-apply got EROFS no matter who owned the directory. The
# button answered "Internal server error", which is not a sentence anybody can
# act on.
#
# Both are prefixed `-` so a missing directory is a feature that refuses and
# says what to run instead, rather than a panel that will not start at all.
ReadWritePaths=-/var/lib/hopper/updates
ReadWritePaths=-/var/lib/hopper/node-apply

LimitNOFILE=16384

StandardOutput=journal
StandardError=journal
SyslogIdentifier=hopper-panel

[Install]
WantedBy=multi-user.target
