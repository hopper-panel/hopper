[Unit]
Description=Hopper Panel update
Documentation=https://github.com/hopper-panel/hopper
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot

# Root, because updating means writing into /opt/hopper and restarting units.
#
# The panel never runs this. It creates an empty file in a directory it is
# allowed to write, and `hopper-update.path` reacts to it. The panel therefore
# cannot say *what* to run — no command, no argument, no shell reaches this
# unit. A compromised panel gains "trigger the updater", not "run anything as
# root", which is what a sudoers rule would have given it.
User=root
Group=root

# The trigger is removed first. Left in place it would refire the path unit the
# moment this service exits, and the machine would update in a loop.
ExecStartPre=/bin/rm -f /var/lib/hopper/updates/requested
ExecStartPre=/bin/sh -c 'printf "{\\"state\\":\\"running\\",\\"startedAt\\":\\"%%s\\"}" "$(date -Is)" > /var/lib/hopper/updates/status.json'

# The update works from its own clone, not from /opt/hopper.
#
# install.sh copies the sources with `--exclude=.git`, so /opt/hopper is not a
# checkout and never can be pulled — the first version of this unit assumed it
# was and failed with "not a git repository" the first time an operator pressed
# the button. This clone is the updater's own, kept beside the data where root
# owns everything, and install.sh run from it copies over /opt/hopper exactly as
# a fresh installation does.
ExecStart=/bin/bash -c 'if [ -d /var/lib/hopper/source/.git ]; then \
    git -C /var/lib/hopper/source fetch --depth 1 origin main && \
    git -C /var/lib/hopper/source reset --hard origin/main; \
  else \
    rm -rf /var/lib/hopper/source && \
    git clone --depth 1 https://github.com/hopper-panel/hopper.git /var/lib/hopper/source; \
  fi'
ExecStart=/bin/bash /var/lib/hopper/source/install/install.sh

ExecStopPost=/bin/sh -c 'if [ "$EXIT_STATUS" = "0" ]; then S=succeeded; else S=failed; fi; \
  printf "{\\"state\\":\\"%%s\\",\\"finishedAt\\":\\"%%s\\",\\"log\\":\\"%%s\\"}" \
  "$S" "$(date -Is)" "$(journalctl -u hopper-update -n 30 --no-pager -o cat | tail -c 3000 | sed "s/[\\\\\\"]/ /g" | tr "\n" " ")" \
  > /var/lib/hopper/updates/status.json'

# The installer is not interactive here: every answer is already in .env, the
# vhost and daemon.yml, all of which a rerun keeps.
Environment=HOPPER_NONINTERACTIVE=1
Environment=NO_COLOR=1

TimeoutStartSec=1800
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hopper-update
