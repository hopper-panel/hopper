# Hopper Panel — nginx
#
# Generated by install.sh. The values between {{ }} are replaced at install time.
# This file is not overwritten by an update: your changes are kept.

server {
    listen 80;
    listen [::]:80;
    server_name {{DOMAIN}};

    # Certbot drops its token here; everything else goes to HTTPS.
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name {{DOMAIN}};

    ssl_certificate     {{CERT}};
    ssl_certificate_key {{KEY}};

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # The panel already emits its own security headers (CSP included):
    # redefining them here would make them diverge at the first update.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # File uploads go through the panel, which relays them to the daemon.
    # The nginx default — 1 MB — would refuse even the smallest plugin.
    client_max_body_size 1024m;
    # A slow upload must not be cut off halfway: the client may be behind an
    # ADSL line and the file may weigh several hundred MB.
    client_body_timeout 300s;
    proxy_read_timeout 300s;

    location / {
        proxy_pass http://127.0.0.1:{{PORT}};

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Without these two lines the console stays silent: the panel accepts
        # the WebSocket upgrade, but nginx does not forward it.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
